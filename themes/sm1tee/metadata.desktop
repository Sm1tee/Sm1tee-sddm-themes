[SddmGreeterTheme]
Name=sm1tee
Type=sddm-theme
License=GPL-3.0-or-later
Version=0.1
Theme-Id=sm1tee
Theme-API=2.0
MainScript=Main.qml
TranslationsDirectory=translations
QtVersion=6

ConfigFile=configs/dark_knight_storm.conf

